; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="A Cut Above"
config/tags=PackedStringArray("game")
run/main_scene="uid://b85h5nq688wra"
config/features=PackedStringArray("4.6", "Mobile")
run/max_fps=144
config/icon="res://icon.svg"

[autoload]

model="*res://Data Structures/Model.gd"

[debug]

gdscript/warnings/unassigned_variable=0
gdscript/warnings/unused_variable=0

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=3
window/handheld/orientation=1
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

