[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=576
common/max_physics_steps_per_frame=100
common/physics_jitter_fix=1.25
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=1000240
3d/solver/solver_iterations=4
jolt_3d/limits/max_bodies=60240

[rendering]

textures/vram_compression/import_etc2_astc=true
occlusion_culling/occlusion_rays_per_thread=800
occlusion_culling/use_occlusion_culling=true
